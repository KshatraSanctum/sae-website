# Optional HTTP API base URL for future service integrations.
# Leave blank to keep the request client unconfigured.
VITE_API_BASE_URL=

# Optional request timeout in milliseconds. Defaults to 10000.
VITE_API_TIMEOUT_MS=10000

# Optional public Supabase project settings for browser auth and race services.
# These are placeholders only; never put service-role keys or other private
# credentials in VITE_ variables because Vite exposes them to the browser.
VITE_SUPABASE_URL=
# Preferred browser-public key name.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy browser-public alias; use the publishable key above for new setups.
VITE_SUPABASE_ANON_KEY=
